# Copy to .env. Replace ALL four paths with existing directories OUTSIDE this repo.
# Docker Desktop accepts absolute host paths with forward slashes.
DEE_ORIGINALS_DIR=/absolute/path/to/case/originals
DEE_WORKING_DIR=/absolute/path/to/case/working
DEE_DATABASE_DIR=/absolute/path/to/case/database
DEE_OUTPUT_DIR=/absolute/path/to/case/output
# On Linux, set these to your user's numeric UID/GID for bind mount permissions.
DEE_UID=1000
DEE_GID=1000
